root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
insert_final_newline = true

[*.{cs,xaml}]
indent_size = 4

[*.{csproj,props,slnx,json}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# Formatos legados exigem nomes que espelham as chaves originais.
dotnet_diagnostic.CA1707.severity = none
# Palavras reservadas do VB (Stop, Loop) não se aplicam: o código é só C#.
dotnet_diagnostic.CA1716.severity = none
