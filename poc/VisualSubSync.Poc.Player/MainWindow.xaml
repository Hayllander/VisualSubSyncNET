<Window x:Class="VisualSubSync.Poc.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisualSubSync.Poc.Player"
        xmlns:wave="clr-namespace:VisualSubSync.Waveform;assembly=VisualSubSync.Waveform"
        Title="VisualSubSync - prova de conceito libmpv + FFmpeg" Width="960" Height="720"
        UseLayoutRounding="True">
  <DockPanel>
    <ToolBar DockPanel.Dock="Top">
      <Button Content="Abrir vídeo..." Click="OnOpen" />
      <Button Content="Abrir legenda..." Click="OnOpenSubtitle" />
      <Separator />
      <Button Content="Play/Pause (Espaço)" Click="OnPlayPause" />
      <Button Content="Tocar seleção" Click="OnPlaySelection" />
      <ToggleButton x:Name="LoopToggle" Content="Loop" />
      <Button Content="Parar" Click="OnStop" />
      <Separator />
      <Button Content="Quadro inicial" Click="OnShowStart" ToolTip="Show start frame" />
      <Button Content="Quadro final" Click="OnShowStop" ToolTip="Show stop frame" />
      <Separator />
      <TextBlock Text="Velocidade " VerticalAlignment="Center" />
      <ComboBox x:Name="RateBox" SelectedIndex="4" SelectionChanged="OnRateChanged" Width="70">
        <ComboBoxItem Content="60%" Tag="0.6" />
        <ComboBoxItem Content="70%" Tag="0.7" />
        <ComboBoxItem Content="80%" Tag="0.8" />
        <ComboBoxItem Content="90%" Tag="0.9" />
        <ComboBoxItem Content="100%" Tag="1.0" />
      </ComboBox>
    </ToolBar>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Abra um vídeo." />
      </StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="4" />
        <RowDefinition Height="200" />
      </Grid.RowDefinitions>
      <Border Background="Black">
        <local:VideoHost x:Name="Video" />
      </Border>
      <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
      <wave:WaveformControl x:Name="Wave" Grid.Row="2" PageSizeMs="10000" />
    </Grid>
  </DockPanel>
</Window>
