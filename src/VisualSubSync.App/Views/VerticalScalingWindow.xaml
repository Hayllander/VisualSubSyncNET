<Window x:Class="VisualSubSync.App.Views.VerticalScalingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vertical scaling"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Microsoft Sans Serif" FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
  <!-- TVerticalScalingForm (docs/enhanced/TVERTICALSCALINGFORM.txt). ClientWidth 321, ClientHeight 98,
       BorderWidth 3, BorderStyle = bsToolWindow, FormStyle = fsStayOnTop, Position = poMainFormCenter.
       GroupBox1 (Align = alClient) tem fonte de 13 px em negrito; os filhos usam a de 11 px. -->
  <Border Padding="3">
    <Canvas Width="321" Height="98">
      <Border Canvas.Left="0" Canvas.Top="8" Width="321" Height="90" Style="{StaticResource VssGroupFrame}" />
      <TextBlock x:Name="GroupCaption" Canvas.Left="8" Canvas.Top="0" Height="16" FontSize="13" FontWeight="Bold"
                 Style="{StaticResource VssGroupCaption}" Text=" Scaling : XXX% " />
      <Button x:Name="bttReset" Canvas.Left="232" Canvas.Top="0" Width="67" Height="25" Content="Reset"
              TabIndex="1" Click="OnReset" />
      <Slider x:Name="ScalingTrackBar" Canvas.Left="10" Canvas.Top="35" Width="297" Height="33" TabIndex="0"
              Minimum="50" Maximum="800" SmallChange="10" LargeChange="50" TickFrequency="50"
              TickPlacement="BottomRight" Value="700" ValueChanged="OnScalingChanged" />
      <TextBlock Canvas.Left="14" Canvas.Top="70" Text="50" />
      <TextBlock Canvas.Left="30" Canvas.Top="70" Text="100" />
      <TextBlock Canvas.Left="67" Canvas.Top="70" Text="200" />
      <TextBlock Canvas.Left="103" Canvas.Top="70" Text="300" />
      <TextBlock Canvas.Left="140" Canvas.Top="70" Text="400" />
      <TextBlock Canvas.Left="176" Canvas.Top="70" Text="500" />
      <TextBlock Canvas.Left="214" Canvas.Top="70" Text="600" />
      <TextBlock Canvas.Left="249" Canvas.Top="71" Text="700" />
      <TextBlock Canvas.Left="286" Canvas.Top="70" Text="800" />
    </Canvas>
  </Border>
</Window>
