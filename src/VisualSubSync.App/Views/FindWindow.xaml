<Window x:Class="VisualSubSync.App.Views.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find subtitle"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Microsoft Sans Serif" FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyUp="OnKeyUp">
  <!-- TFindForm (docs/enhanced/TFINDFORM.txt). ClientWidth 339, ClientHeight 185, BorderWidth 4,
       FormStyle = fsStayOnTop, Position = poDefault. SetMemoMode(False) troca o título para
       "Find subtitle". -->
  <Border Padding="4">
    <Canvas Width="339" Height="185">
      <TextBlock Canvas.Left="0" Canvas.Top="4" Width="23" Height="13" Text="Find:" />
      <TextBlock Canvas.Left="0" Canvas.Top="28" Width="65" Height="13" Text="Replace with:" />
      <ComboBox x:Name="cbFind" Canvas.Left="72" Canvas.Top="0" Width="265" Height="21" IsEditable="True"
                TabIndex="0" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                TextBoxBase.TextChanged="OnFindTextChanged" PreviewKeyDown="OnComboKeyDown" />
      <ComboBox x:Name="cbReplaceWith" Canvas.Left="72" Canvas.Top="24" Width="265" Height="21" IsEditable="True"
                TabIndex="1" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                PreviewKeyDown="OnComboKeyDown" />

      <!-- TntGroupBox1 : "Options" -->
      <Border Canvas.Left="0" Canvas.Top="56" Width="153" Height="129" Style="{StaticResource VssGroupFrame}" />
      <TextBlock Canvas.Left="8" Canvas.Top="49" Height="14" Style="{StaticResource VssGroupCaption}" Text="Options" />
      <CheckBox x:Name="chkMatchCase" Canvas.Left="8" Canvas.Top="80" Width="97" Height="17" TabIndex="2"
                Content="Case sensitive" IsChecked="{Binding FindMatchCase}" Click="OnMatchCaseClick" />
      <CheckBox x:Name="chkFromCursor" Canvas.Left="8" Canvas.Top="96" Width="81" Height="17" TabIndex="3"
                Content="From cursor" IsChecked="{Binding FindFromCursor}" />
      <CheckBox x:Name="chkWholeWord" Canvas.Left="8" Canvas.Top="112" Width="97" Height="17" TabIndex="4"
                Content="Whole Word" IsChecked="{Binding FindWholeWord}" />
      <CheckBox x:Name="chkRegExp" Canvas.Left="8" Canvas.Top="128" Width="121" Height="17" TabIndex="5"
                Content="Regular Expression" IsChecked="{Binding FindUseRegExp}" Click="OnRegExpClick" />
      <CheckBox x:Name="chkMatchingOnly" Canvas.Left="8" Canvas.Top="147" Width="137" Height="17" TabIndex="6"
                Content="Show matching sub only" Click="OnMatchingOnlyClick" />
      <!-- chkDisableVOSearch: a busca no VO entra com o VO. -->
      <CheckBox Canvas.Left="7" Canvas.Top="165" Width="137" Height="17" TabIndex="7"
                Content="Disable VO search" IsChecked="True" IsEnabled="False" />

      <!-- Panel1 (160, 56) -->
      <Button Canvas.Left="168" Canvas.Top="64" Width="81" Height="25" Content="Find" TabIndex="8" Click="OnFind" />
      <Button x:Name="bttReplaceFind" Canvas.Left="256" Canvas.Top="64" Width="81" Height="25" Content="Replace/Find"
              TabIndex="9" IsEnabled="False" Click="OnReplaceFind" />
      <Button x:Name="bttReplace" Canvas.Left="168" Canvas.Top="94" Width="81" Height="25" Content="Replace"
              TabIndex="10" IsEnabled="False" Click="OnReplace" />
      <Button Canvas.Left="256" Canvas.Top="94" Width="81" Height="25" Content="Replace All" TabIndex="11"
              Click="OnReplaceAll" />

      <Button Canvas.Left="256" Canvas.Top="160" Width="83" Height="25" Content="Close" TabIndex="12" Click="OnClose" />
    </Canvas>
  </Border>
</Window>
