<Window x:Class="VisualSubSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VisualSubSync.App.ViewModels"
        xmlns:conv="clr-namespace:VisualSubSync.App.Converters"
        xmlns:ctl="clr-namespace:VisualSubSync.App.Controls"
        xmlns:wave="clr-namespace:VisualSubSync.Waveform;assembly=VisualSubSync.Waveform"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="/Assets/VSS.ico"
        Width="1083" Height="755"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Microsoft Sans Serif" FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- Layout do TMainForm do VisualSubSync Enhanced (docs/enhanced/TMAINFORM.txt). Posições e tamanhos em pixels. -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />

    <!-- TPanel com BevelOuter = bvLowered: sombra em cima/esquerda, realce embaixo/direita. -->
    <Style x:Key="LoweredPanel" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Background="{TemplateBinding Background}">
              <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                <ContentPresenter />
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- TSpeedButton: não recebe foco; o glifo fica centrado. -->
    <Style x:Key="SpeedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="ReadOnlyEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Width" Value="73" />
      <Setter Property="Height" Value="21" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="IsEnabled" Value="{Binding IsProjectOpen}" />
    </Style>

    <!-- Rótulos Begin/End/Length do PanelTimeSelView no Enhanced: negrito, sublinhado, azul-marinho. -->
    <Style x:Key="SelLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextDecorations" Value="Underline" />
      <Setter Property="Foreground" Value="Navy" />
      <Setter Property="IsEnabled" Value="{Binding IsProjectOpen}" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Cabeçalho do TPageControl do Enhanced: faixa de 24 px. O painel de abas do WPF ocupa
         3 px a mais que o TabItem, por isso 21 e não 24. Só a aba principal; as abas
         aninhadas dos painéis novos têm altura própria, definida no DFM. -->
    <Style x:Key="MainTabItem" TargetType="TabItem">
      <Setter Property="Height" Value="21" />
    </Style>

    <!-- Cabeçalho do TVirtualStringTree: plano, fonte MS Sans Serif 8. -->
    <Style x:Key="SubListHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Seleção "blended" em linha inteira, como toUseBlendedSelection + toFullRowSelect. -->
    <Style x:Key="SubListCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SubListRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background">
            <Setter.Value>
              <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" Opacity="0.5" />
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
    <!-- As ações com Tag = 1 usam a tabela [Hotkeys] (Normal/Timing), em MainWindow.Hotkeys.cs. -->
  </Window.InputBindings>
