                <Thumb x:Name="SplitterSubtitleVO" DockPanel.Dock="Right" Width="4" Visibility="Collapsed" Cursor="SizeWE"
                       DragDelta="SplitterSubtitleVO_DragDelta">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" /></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
                <TextBox x:Name="MemoSubtitleText"
                         Text="{Binding SelectedSubtitle.Text, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsSubtitleEditionEnabled}" IsUndoEnabled="False" IsInactiveSelectionHighlightEnabled="True"
                         AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Hidden"
                         SelectionChanged="MemoSubtitleText_Changed" TextChanged="MemoSubtitleText_Changed"
                         ScrollViewer.ScrollChanged="MemoSubtitleText_Changed">
                  <!-- MemoSubPopupMenu (layout do Enhanced); as sugestões do corretor entram acima de Undo. -->
                  <TextBox.ContextMenu>
                    <ContextMenu x:Name="MemoSubPopupMenu">
                      <MenuItem x:Name="MenuItemMemoSubUndo" Header="Undo" Tag="ActionUndo" Command="{Binding UndoCommand}"><MenuItem.Icon><Image Source="/Assets/Menu/il_31.png" /></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem Header="Cut" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"><MenuItem.Icon><Image Source="/Assets/Menu/il_28.png" /></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"><MenuItem.Icon><Image Source="/Assets/Menu/il_29.png" /></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"><MenuItem.Icon><Image Source="/Assets/Menu/il_30.png" /></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Delete" Command="EditingCommands.Delete" InputGestureText="Del"><MenuItem.Icon><Image Source="/Assets/Menu/il_32.png" /></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
                      <Separator />
                      <MenuItem Header="Text in italic" Tag="ActionTextItalic" Command="{Binding TextItalicCommand}"><MenuItem.Icon><Image Source="/Assets/Menu/il_62.png" /></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Other styles">
                        <MenuItem Header="Text in bold" Tag="ActionTextBold" Command="{Binding TextBoldCommand}"><MenuItem.Icon><Image Source="/Assets/Menu/il_58.png" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Text in underline" Tag="ActionTextUnderline" Command="{Binding TextUnderlineCommand}"><MenuItem.Icon><Image Source="/Assets/Menu/il_59.png" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Text color" Tag="ActionTextColor" Command="{Binding TextColorCommand}"><MenuItem.Icon><Image Source="/Assets/Menu/il_60.png" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Text size" Tag="ActionTextSize" Command="{Binding TextSizeCommand}"><MenuItem.Icon><Image Source="/Assets/Menu/il_61.png" /></MenuItem.Icon></MenuItem>
                      </MenuItem>
                    </ContextMenu>
                  </TextBox.ContextMenu>
                </TextBox>
              </DockPanel>
            </Border>
          </Grid>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
