    <!-- StatusBarMainPanel: dois TPanel rebaixados, o primeiro com 250 px. -->
    <Grid DockPanel.Dock="Bottom" Height="19">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ContentControl Style="{StaticResource LoweredPanel}">
        <TextBlock Text="{Binding EditorStatusText}" Margin="3,0" VerticalAlignment="Center" />
      </ContentControl>
      <ContentControl Grid.Column="1" Style="{StaticResource LoweredPanel}">
        <TextBlock Text="{Binding StatusText}" Margin="3,0" VerticalAlignment="Center" />
      </ContentControl>
    </Grid>

    <Grid x:Name="MainGrid">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="TopRow" Height="225" MinHeight="40" />
        <RowDefinition Height="4" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- PanelTop: forma de onda e, à direita, o splitter e o vídeo (só aparecem com o motor de mídia). -->
      <ContentControl Grid.Row="0" Style="{StaticResource LoweredPanel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <!-- MemoTextPipe (250 px, alLeft) e SplitterMemoTextPipe (4 px, clSilver, MinSize 50): largura 0 enquanto escondidos. -->
            <ColumnDefinition x:Name="TextPipeColumn" Width="0" />
            <ColumnDefinition x:Name="TextPipeSplitterColumn" Width="0" />
            <ColumnDefinition Width="*" />
            <!-- SplitterWAVDisplay_Video: 4 px, clGray; fica com largura 0 enquanto o vídeo está escondido. -->
            <ColumnDefinition x:Name="VideoSplitterColumn" Width="0" />
            <!-- PanelVideo: 201 px por padrão; a largura salva no projeto tem prioridade (UpdateVideoRendererWindow). -->
            <ColumnDefinition x:Name="VideoColumn" Width="0" />
          </Grid.ColumnDefinitions>
          <RichTextBox x:Name="MemoTextPipe" Grid.Column="0" Visibility="Collapsed"
                       VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                       AcceptsTab="False" IsUndoEnabled="False" IsInactiveSelectionHighlightEnabled="True"
