<Window x:Class="VisualSubSync.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About..."
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Arial" FontSize="11" FontWeight="Bold"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=bttOk}"
        PreviewKeyDown="OnPreviewKeyDown">
  <!-- TAboutForm (AboutFormUnit.dfm do 1.0.1; o Enhanced só acrescenta os créditos dele). -->
  <Border Padding="4">
    <Canvas Width="345" Height="322">
      <TextBlock x:Name="TntLabel1" Canvas.Left="0" Canvas.Top="0" Width="345" Height="33" TextAlignment="Center"
                 Text="VisualSubSyncNET" FontSize="24" Foreground="Blue" TextDecorations="Underline" Cursor="Hand"
                 MouseLeftButtonUp="OnSiteClick" />
      <!-- Bevel1: bsBottomLine. -->
      <Border Canvas.Left="0" Canvas.Top="39" Width="345" Height="2" BorderThickness="0,1,0,1"
              BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
        <Border BorderThickness="0,0,0,1" Margin="0,0,0,-1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}" />
      </Border>
      <TextBlock x:Name="LabelVersion" Canvas.Left="8" Canvas.Top="48" FontSize="16" Text="Version : 2.0.0.00" />
      <TextBlock Canvas.Left="8" Canvas.Top="77" Text="Copyright 2026" />
      <TextBlock Canvas.Left="219" Canvas.Top="71" Width="118" TextAlignment="Center" TextWrapping="Wrap">
        <Run Text="by Clediomar, Santos" />
        <LineBreak />
        <Run Text="Hayllander" />
      </TextBlock>
      <TextBlock x:Name="EmailPrimaryLink" Canvas.Left="8" Canvas.Top="108" Text="geekcdtoys@gmail.com"
                 Foreground="Blue" TextDecorations="Underline" Cursor="Hand"
                 MouseLeftButtonUp="OnTaggedLinkClick" Tag="mailto:geekcdtoys@gmail.com?subject=VisualSubSyncNET Version 2.0.0.00" />
      <TextBlock x:Name="EmailSecondaryLink" Canvas.Left="8" Canvas.Top="126" Text="kisifolda@gmail.com"
                 Foreground="Blue" TextDecorations="Underline" Cursor="Hand"
                 MouseLeftButtonUp="OnTaggedLinkClick" Tag="mailto:kisifolda@gmail.com?subject=VisualSubSyncNET Version 2.0.0.00" />
      <TextBlock x:Name="ProductSiteLink" Canvas.Left="182" Canvas.Top="108" Width="155" FontSize="10"
                 Text="http://legendasrt.com.br/VisualSubSyncNET/" Foreground="Blue" TextDecorations="Underline"
                 Cursor="Hand" TextWrapping="Wrap" MouseLeftButtonUp="OnTaggedLinkClick"
                 Tag="http://legendasrt.com.br/VisualSubSyncNET/" />
      <TextBlock x:Name="MainSiteLink" Canvas.Left="182" Canvas.Top="138" Width="155" FontSize="10"
                 Text="http://legendasrt.com.br/" Foreground="Blue" TextDecorations="Underline" Cursor="Hand"
                 TextWrapping="Wrap" MouseLeftButtonUp="OnTaggedLinkClick" Tag="http://legendasrt.com.br/" />
      <TextBlock Canvas.Left="8" Canvas.Top="176" Width="329" FontWeight="Normal"
                 Text="Thanks to the authors of the following components :" />
      <TextBlock x:Name="lblMpv" Canvas.Left="8" Canvas.Top="192" Width="300" FontWeight="Normal"
                 Text="- mpv / libmpv by the mpv developers" />
      <TextBlock x:Name="lblFFmpeg" Canvas.Left="8" Canvas.Top="208" Width="300" FontWeight="Normal"
                 Text="- FFmpeg by the FFmpeg developers" />
      <TextBlock x:Name="lblJS" Canvas.Left="8" Canvas.Top="224" Width="300" FontWeight="Normal"
                 Text="- Jint JavaScript Engine by Sébastien Ros" />
      <TextBlock x:Name="lblSpell" Canvas.Left="8" Canvas.Top="240" Width="320" FontWeight="Normal"
                 Text="- Hunspell by László Németh (WeCantSpell.Hunspell)" />
      <TextBlock x:Name="lblMvvm" Canvas.Left="8" Canvas.Top="256" Width="320" FontWeight="Normal"
                 Text="- CommunityToolkit.Mvvm by the .NET Foundation" />
      <!-- Bevel2: bsBottomLine. -->
      <Border Canvas.Left="0" Canvas.Top="288" Width="345" Height="2" BorderThickness="0,1,0,1"
              BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
        <Border BorderThickness="0,0,0,1" Margin="0,0,0,-1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}" />
      </Border>
      <Button x:Name="bttOk" Canvas.Left="8" Canvas.Top="297" Width="329" Height="25" Content="OK" IsDefault="True"
              TabIndex="0" Click="OnOk" />
    </Canvas>
  </Border>
</Window>
