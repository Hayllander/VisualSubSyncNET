<Window x:Class="VisualSubSync.App.Views.SuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suggestions"
        Left="209" Top="115" Width="273" Height="436" MinWidth="100" MinHeight="200"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Microsoft Sans Serif" FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
  <!-- TSuggestionForm (docs/enhanced/TSUGGESTIONFORM.txt). Width 273, Height 436, BorderWidth 4,
       bsSizeToolWin, fsStayOnTop. vtvSuggestionsLst (0,0,257x321, ancorada nos quatro lados, seleção
       múltipla, duas linhas por nó: "From ... to ..." em negrito e o texto) e MemoSuggPreview
       (Top 328, 73 px, negrito, só leitura). -->
  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="7" />
      <RowDefinition Height="73" />
    </Grid.RowDefinitions>
    <ListBox x:Name="vtvSuggestionsLst" ItemsSource="{Binding Suggestions}" SelectionMode="Extended"
             FontFamily="Arial" FontSize="11" TabIndex="0"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnSuggestionDoubleClick">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Clear selected" Click="OnClearSelected" />
          <MenuItem Header="Clear all" Click="OnClearAll" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemContainerStyle>
        <!-- toShowHorzGridLines/toShowVertGridLines e toFullRowSelect. -->
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="BorderThickness" Value="0,0,1,1" />
          <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <!-- CalculateNodeHeight: margem de 2 px, duas linhas de 1,1 vez a altura do texto. -->
        <DataTemplate>
          <StackPanel Margin="10,2,0,2">
            <TextBlock Height="15" FontWeight="Bold" Text="{Binding Header}" />
            <TextBlock Height="15" Text="{Binding Line}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBox x:Name="MemoSuggPreview" Grid.Row="2" IsReadOnly="True" TabIndex="1"
             FontFamily="Arial" FontSize="11" FontWeight="Bold"
             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" />
  </Grid>
</Window>
