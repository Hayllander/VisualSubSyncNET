<Window x:Class="VisualSubSync.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log window"
        Left="204" Top="103" Width="505" Height="167"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Microsoft Sans Serif" FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- TLogForm (docs/enhanced/TLOGFORM.txt): Width 505, Height 167, BorderStyle = bsSizeToolWin,
       FormStyle = fsStayOnTop, MainMenu1 e MemoLog (alClient, Courier New 11 px, ssVertical). -->
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="Window">
        <MenuItem Header="Clear" Click="OnClear" />
        <MenuItem x:Name="miStayHidden" Header="Stay hidden" IsCheckable="True" Click="OnStayHidden" />
        <MenuItem Header="Close" Click="OnClose" />
      </MenuItem>
      <MenuItem Header="Debug">
        <MenuItem Header="List used DirectShow filters" IsEnabled="False" />
      </MenuItem>
    </Menu>
    <TextBox x:Name="MemoLog" FontFamily="Courier New" FontSize="11" AcceptsReturn="True"
             VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Hidden" TextWrapping="Wrap" />
  </DockPanel>
</Window>
