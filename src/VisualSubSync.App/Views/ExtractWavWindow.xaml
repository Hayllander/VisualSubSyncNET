<Window x:Class="VisualSubSync.App.Views.ExtractWavWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract WAV"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Microsoft Sans Serif" FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- TExtractWAVForm (docs/enhanced/TEXTRACTWAVFORM.txt). ClientWidth 483, ClientHeight 504,
       BorderWidth 4: o recuo interno da janela corresponde ao Padding do Border. -->
  <Border Padding="4">
    <Canvas Width="483" Height="504">

      <!-- TntGroupBox1 : " Video/Audio info : " -->
      <Border Canvas.Left="0" Canvas.Top="0" Width="481" Height="291" Style="{StaticResource VssGroupFrame}" />
      <TextBlock Canvas.Left="8" Canvas.Top="-7" Height="14" Style="{StaticResource VssGroupCaption}"
                 Text=" Video/Audio info : " />
      <TextBox x:Name="MemoVideoInfo" Canvas.Left="8" Canvas.Top="15" Width="464" Height="267" TabIndex="0"
               IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />

      <TextBlock Canvas.Left="0" Canvas.Top="437" Width="47" Height="13" Text="Progress :" />
      <ProgressBar x:Name="Progress" Canvas.Left="56" Canvas.Top="431" Width="423" Height="25"
                   Minimum="0" Maximum="1000" />

      <!-- gbSettings : " Settings : " (agrupado em um Canvas para poder ser desabilitado em bloco) -->
      <Canvas x:Name="SettingsFrame" KeyboardNavigation.TabIndex="3">
        <Border Canvas.Left="0" Canvas.Top="306" Width="481" Height="116" Style="{StaticResource VssGroupFrame}" />
        <TextBlock Canvas.Left="8" Canvas.Top="299" Height="14" Style="{StaticResource VssGroupCaption}"
                   Text=" Settings : " />
        <TextBlock x:Name="StreamToExtractLabel" Canvas.Left="8" Canvas.Top="322" Width="86" Height="13"
                   Text="Stream to extract :" Visibility="Collapsed" />
        <ComboBox x:Name="StreamIndexCombo" Canvas.Left="104" Canvas.Top="318" Width="369" Height="21"
                  Visibility="Collapsed" />
        <RadioButton x:Name="OnlyPeakRadio" Canvas.Left="8" Canvas.Top="354" Width="137" Height="17"
                     Content="Only create peak file" IsChecked="True" />
        <RadioButton x:Name="NoConversionRadio" Canvas.Left="8" Canvas.Top="374" Width="113" Height="17"
                     Content="Simple extraction" />
        <RadioButton x:Name="FastConversionRadio" Canvas.Left="8" Canvas.Top="394" Width="401" Height="17"
                     Content="Convert to reduce file size (Mono + Sample rate divided by 2)" />
      </Canvas>

      <Button x:Name="ExtractButton" Canvas.Left="27" Canvas.Top="471" Width="75" Height="25"
              Content="Extract" TabIndex="1" Click="OnExtract" />
      <Button x:Name="StopButton" Canvas.Left="107" Canvas.Top="471" Width="75" Height="25"
              Content="Stop" IsEnabled="False" TabIndex="4" Click="OnStop" />
      <Button x:Name="DebugButton" Canvas.Left="235" Canvas.Top="471" Width="75" Height="25"
              Content="Debug" TabIndex="5" Click="OnDebug" />
      <Button x:Name="CloseButton" Canvas.Left="379" Canvas.Top="471" Width="75" Height="25"
              Content="Cancel" TabIndex="2" IsCancel="True" />
    </Canvas>
  </Border>
</Window>
