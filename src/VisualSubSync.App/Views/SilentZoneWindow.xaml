<Window x:Class="VisualSubSync.App.Views.SilentZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VisualSubSync.App.Controls"
        Title="Silent zones"
        Left="246" Top="77" Width="314" Height="331"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Microsoft Sans Serif" FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
  <!-- TSilentZoneForm (docs/enhanced/TSILENTZONEFORM.txt). Width 314, Height 331, BorderWidth 4,
       BorderStyle = bsSizeToolWin, FormStyle = fsStayOnTop. TntGroupBox1 (alTop, 49 px), TntBevel1
       (alTop, 4 px) e lbSilentZones (alClient); bttUpdate preso à direita (Anchors do Enhanced). -->
  <DockPanel Margin="4">
    <Grid DockPanel.Dock="Top" Height="49">
      <Border Margin="0,6,0,0" Style="{StaticResource VssGroupFrame}" />
      <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0" Height="14"
                 Style="{StaticResource VssGroupCaption}" Text=" Settings " />
      <Canvas KeyboardNavigation.TabIndex="1">
        <TextBlock Canvas.Left="8" Canvas.Top="20" Text="Threshold:" />
        <ctl:UpDownEdit x:Name="udThreshold" Canvas.Left="64" Canvas.Top="16" Width="56" Height="21"
                        Minimum="0" Maximum="32767" Increment="10" Text="100"
                        KeyboardNavigation.TabIndex="1" ToolTip="Threshold between 0 and 32767"/>
        <TextBlock Canvas.Left="128" Canvas.Top="20" Text="Duration:" />
        <ctl:UpDownEdit x:Name="udDuration" Canvas.Left="176" Canvas.Top="16" Width="56" Height="21"
                        Minimum="100" Maximum="9999" Increment="100" Text="500" KeyboardNavigation.TabIndex="2"
                        ToolTip="Minimum duration of the silent zone in ms (100..9999)" />
      </Canvas>
      <Button x:Name="bttUpdate" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,3,0"
              Width="47" Height="25" Content="Update" TabIndex="2" Click="OnUpdate" />
    </Grid>
    <Border DockPanel.Dock="Top" Height="4" />
    <ListBox x:Name="lbSilentZones" TabIndex="0" MouseDoubleClick="OnZoneDoubleClick" />
  </DockPanel>
</Window>
