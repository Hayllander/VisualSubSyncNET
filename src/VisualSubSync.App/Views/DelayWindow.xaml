<Window x:Class="VisualSubSync.App.Views.DelayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VisualSubSync.App.Controls"
        Title="Delay"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Microsoft Sans Serif" FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=meDelay}"
        KeyUp="OnKeyUp">
  <!-- TDelayForm (docs/enhanced/TDELAYFORM.txt). ClientWidth 193, ClientHeight 289, BorderWidth 6.
       Os itens de cada TTntRadioGroup seguem ArrangeButtons da VCL (margem de 14 px, altura dividida
       igualmente). -->
  <Border Padding="6">
    <Canvas Width="193" Height="289">

      <!-- rgType : " Type : " (Columns = 2) -->
      <Border Canvas.Left="0" Canvas.Top="0" Width="193" Height="41" Style="{StaticResource VssGroupFrame}" />
      <TextBlock Canvas.Left="8" Canvas.Top="-7" Height="14" Style="{StaticResource VssGroupCaption}" Text=" Type : " />
      <Canvas KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Once"
              KeyboardNavigation.DirectionalNavigation="Cycle">
        <RadioButton x:Name="TypePositive" Canvas.Left="8" Canvas.Top="17" Width="91" Height="17" GroupName="Type"
                     Content="Positive (+)" IsChecked="True" />
        <RadioButton x:Name="TypeNegative" Canvas.Left="99" Canvas.Top="17" Width="91" Height="17" GroupName="Type"
                     Content="Negative (-)" />
      </Canvas>

      <ctl:MaskTimeEdit x:Name="meDelay" Canvas.Left="0" Canvas.Top="52" Width="193" Height="21"
                        VerticalContentAlignment="Center" TabIndex="0" />

      <!-- rgApplyTo : " Apply to " -->
      <Border Canvas.Left="0" Canvas.Top="80" Width="193" Height="81" Style="{StaticResource VssGroupFrame}" />
      <TextBlock Canvas.Left="8" Canvas.Top="73" Height="14" Style="{StaticResource VssGroupCaption}" Text=" Apply to " />
      <Canvas KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Once"
              KeyboardNavigation.DirectionalNavigation="Cycle">
        <RadioButton x:Name="ApplyAll" Canvas.Left="8" Canvas.Top="96" Width="183" Height="17" GroupName="ApplyTo"
                     Content="All subtitles" IsChecked="True" />
        <RadioButton x:Name="ApplySelected" Canvas.Left="8" Canvas.Top="117" Width="183" Height="17" GroupName="ApplyTo"
                     Content="Selected subtitles" />
        <RadioButton x:Name="ApplyFromCursor" Canvas.Left="8" Canvas.Top="138" Width="183" Height="17" GroupName="ApplyTo"
                     Content="All subtitles from cursor to end" />
      </Canvas>

      <!-- rgShift : " Shift " -->
      <Border Canvas.Left="0" Canvas.Top="168" Width="193" Height="81" Style="{StaticResource VssGroupFrame}" />
      <TextBlock Canvas.Left="8" Canvas.Top="161" Height="14" Style="{StaticResource VssGroupCaption}" Text=" Shift " />
      <Canvas KeyboardNavigation.TabIndex="5" KeyboardNavigation.TabNavigation="Once"
              KeyboardNavigation.DirectionalNavigation="Cycle">
        <RadioButton x:Name="ShiftBoth" Canvas.Left="8" Canvas.Top="184" Width="183" Height="17" GroupName="Shift"
                     Content="Start and end time" IsChecked="True" />
        <RadioButton x:Name="ShiftStart" Canvas.Left="8" Canvas.Top="205" Width="183" Height="17" GroupName="Shift"
                     Content="Start time only" />
        <RadioButton x:Name="ShiftStop" Canvas.Left="8" Canvas.Top="226" Width="183" Height="17" GroupName="Shift"
                     Content="End time only" />
      </Canvas>

      <Button Canvas.Left="8" Canvas.Top="264" Width="81" Height="25" Content="Apply" TabIndex="3" Click="OnApply" />
      <Button Canvas.Left="104" Canvas.Top="264" Width="83" Height="25" Content="Cancel" TabIndex="4" Click="OnCancel" />
    </Canvas>
  </Border>
</Window>
