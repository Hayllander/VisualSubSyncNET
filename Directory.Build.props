<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Company>VisualSubSync</Company>
    <Product>VisualSubSyncNET</Product>
    <Version>2.0.0-alpha.3</Version>
    <!-- Permite compilar os projetos WPF fora do Windows (apenas compilação, não execução). -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>

